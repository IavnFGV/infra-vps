{
  "name": "Infra VPS Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-json",
        "ms-vscode-remote.remote-containers",
                "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "find scripts -maxdepth 1 -type f \\( -name '*.sh' -o -name '*.py' \\) -exec chmod +x {} +",
  "mounts": [
    "source=${localWorkspaceFolder}/.git,target=/workspaces/infra-vps/.git,type=bind,consistency=cached",
    "source=englishbot-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ]
}
