# Telegram notifications for infra-vps scheduled tasks (security report).
# Copy to config/notify.env and commit — values MUST be encrypted:
#   ./scripts/encrypt-value.sh "<bot token>"
#   ./scripts/encrypt-value.sh "<chat id>"
# Chat id: write to the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=enc:REPLACE_ME
TELEGRAM_CHAT_ID=enc:REPLACE_ME
